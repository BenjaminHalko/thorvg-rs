[submodule "thorvg-sys/thorvg"]
	path = thorvg-sys/thorvg
	# Fork of thorvg/thorvg carrying the bare-metal patch series on top of
	# the upstream release tag, plus a fix keeping ThorVG's static mutexes
	# and globals alive past exit and a few Lottie text fixes (its
	# creator-tui branch, see the README); the pinned commit lives only on
	# the fork.
	url = https://github.com/BenjaminHalko/thorvg.git
	branch = creator-tui
[submodule "thorvg-sys/picolibc"]
	path = thorvg-sys/picolibc
	url = https://github.com/picolibc/picolibc.git
